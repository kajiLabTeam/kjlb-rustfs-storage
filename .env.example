# kjlb-rustfs-storage の環境変数
#
# このファイルをコピーして .env を作成する。
#   cp .env.example .env   （または make env で秘密情報を自動生成）
#
# .env は Git 管理外。認証情報を含むため chmod 600 を推奨。
# 変更後は `make up` / `make up-all` で再作成すると反映される。

# ============================================================
# データの保存先（ホスト側のパス）
# ============================================================
# オブジェクトデータとログを bind mount するホスト側ディレクトリ。
# 相対パス (./data など) も使えるので、macOS の Docker Desktop で
# /srv が共有されていない環境ではリポジトリ配下を指定するとよい。
#
# 変更後は `make setup` でディレクトリを作成する。
# 既にデータがある状態で変更すると、以前のデータは見えなくなるので注意。
RUSTFS_DATA_DIR=/srv/rustfs/data
RUSTFS_LOGS_DIR=/srv/rustfs/logs

# ============================================================
# 必須: S3 の認証情報
# ============================================================
# S3 クライアントに設定するアクセスキー / シークレットキー。
# 未設定だと rustfsadmin/rustfsadmin という既知の値になるため、必ず設定する。
# シークレットキーは 32 文字以上のランダム文字列を推奨。
#   例: openssl rand -base64 32 | tr -d '/+=' | cut -c1-40
RUSTFS_ACCESS_KEY=
RUSTFS_SECRET_KEY=

# ============================================================
# 必須: Grafana 管理者
# ============================================================
# 未設定だと admin/admin になる。observability profile を使うなら必ず設定する。
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# ============================================================
# 監視スタック
# ============================================================
# rustfs のテレメトリ送信先。observability profile を使う場合のみ設定する。
# 未設定（空）ならテレメトリを送信しない。監視スタックを起動しない構成では
# 空のままにしておくこと（送信先が居ないまま送り続けるのを避けるため）。
RUSTFS_OBS_ENDPOINT=

# Grafana / Prometheus が生成する絶対 URL のベース。
# 実際に外部からアクセスするホスト名・スキームに合わせる。
# ここがずれるとリダイレクトやリンクが壊れる。
GRAFANA_ROOT_URL=http://localhost/grafana/
PROMETHEUS_EXTERNAL_URL=http://localhost/prometheus/

# ============================================================
# nginx の公開ポート
# ============================================================
# ホスト側で他プロセスと衝突する場合のみ変更する。
# 注意: 既定以外のポートにすると、S3 クライアントは
# Host ヘッダにポート番号を含めて署名するため、
# エンドポイント URL にも必ず同じポートを指定すること。
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
